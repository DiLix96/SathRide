{
  "name": "sathride",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "dev:phone": "tsx --env-file=.env scripts/dev-phone.ts",
    "build": "prisma generate && next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:integration": "tsx --env-file=.env tests/integration.ts",
    "test:browser": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx --env-file=.env prisma/seed.ts",
    "db:admin": "tsx --env-file=.env scripts/setup-admin.ts",
    "db:local": "tsx --env-file=.env scripts/local-db.ts",
    "db:recurring": "tsx --env-file=.env scripts/generate.ts",
    "dev:inbox": "tsx --env-file=.env scripts/dev-inbox.ts",
    "setup": "node scripts/setup.mjs",
    "test:ci": "tsx --env-file=.env scripts/ci.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "better-auth": "^1.7.7",
    "dotenv": "^18.0.5",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.52.0",
    "next": "^16.4.0",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "^10.12.0",
    "eslint-config-next": "^16.4.0",
    "prettier": "^3.9.9",
    "prisma": "^7.10.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  },
  "type": "module",
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "mysql2": "3.24.5"
  },
  "engines": {
    "node": "24.x"
  }
}
