# Docker Compose local database; change password for non-local use.
DATABASE_URL=postgresql://sathride:sathride_local_only@127.0.0.1:5432/sathride
BETTER_AUTH_URL=http://localhost:3000
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
# Local recovery inbox + phone simulation only, blocked in NODE_ENV=production.
DEV_SIMULATION=true
# Optional authenticated delivery webhook. Payload contains {kind,to,text}; keep secret.
DELIVERY_WEBHOOK_URL=
DELIVERY_WEBHOOK_SECRET=
# Optional road-route provider (OSRM-compatible /route/v1/driving).
ROUTING_URL=
# Never configure an emergency number without checking it locally.
EMERGENCY_NUMBER=
# Public OSM raster tiles for low-volume development. Provide a compliant provider for production.
NEXT_PUBLIC_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_TILE_ATTRIBUTION=© OpenStreetMap contributors
